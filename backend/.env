# ===========================
# Backend Configuration (.env)
# ===========================

# Database connection
DB_URL=jdbc:postgresql://localhost:5432/orchestrator
DB_USER=your_db_user
DB_PASS=your_db_password

# Vector DB (for RAG Agent)
VECTOR_DB_URL=http://localhost:8081
VECTOR_DB_API_KEY=your_vector_db_api_key

# GPT / AMAI Agent
GPT_API_KEY=your_openai_or_gpt_api_key
GPT_ENDPOINT=https://api.openai.com/v1/chat/completions
AMAI_AGENT_NAME=AMAI

# SQL Agent
SQL_DB_URL=jdbc:mysql://localhost:3306/yourdb
SQL_DB_USER=your_sql_user
SQL_DB_PASS=your_sql_password

# Logging
LOG_LEVEL=INFO
